<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.kochedykovdev.laba7.controllers.MainController">
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="Справочники">
            <content>
                  <VBox>
                     <children>
                        <AnchorPane VBox.vgrow="ALWAYS">
                           <children>
                              <TableView fx:id="referenceTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                <columns>
                                  <TableColumn fx:id="materialsColumn" prefWidth="75.0" text="Материалы" />
                                  <TableColumn fx:id="suppliersColumn" prefWidth="75.0" text="Поставщики" />
                                  <TableColumn fx:id="toolsColumn" prefWidth="75.0" text="Инструменты" />
                                  <TableColumn fx:id="prorabsColumn" prefWidth="75.0" text="Прорабы" />
                                  <TableColumn fx:id="objectsColumn" prefWidth="75.0" text="Объекты" />
                                </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </AnchorPane>
                        <HBox alignment="BOTTOM_LEFT">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onRefreshReferenceClick" text="Обновить">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#onSearchReferenceClick" text="Поиск">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <TextField fx:id="referenceSearchField" promptText="Фильтр...">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </TextField>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
            </content>
          </Tab>
          <Tab text="Склад">
            <content>
                  <VBox>
                     <children>
                        <AnchorPane VBox.vgrow="ALWAYS">
                           <children>
                              <TableView fx:id="warehouseTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <columns>
                                    <TableColumn fx:id="stockColumn" prefWidth="75.0" text="Остатки" />
                                    <TableColumn fx:id="receiptColumn" prefWidth="75.0" text="Приход" />
                                    <TableColumn fx:id="invoiceColumn" prefWidth="75.0" text="Расходная накладная" />
                                    <TableColumn fx:id="returnColumn" prefWidth="75.0" text="Возврат" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </AnchorPane>
                        <HBox alignment="BOTTOM_LEFT">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onRefreshWarehouseClick" text="Обновить">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#onSearchWarehouseClick" text="Поиск">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <TextField fx:id="warehouseSearchField" promptText="Фильтр...">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </TextField>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
            </content>
          </Tab>
          <Tab text="Отчёты">
            <content>
                  <VBox>
                     <children>
                        <AnchorPane VBox.vgrow="ALWAYS">
                           <children>
                              <TableView fx:id="reportTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <columns>
                                    <TableColumn fx:id="movementColumn" prefWidth="75.0" text="Движение материалов" />
                                    <TableColumn fx:id="debtorsColumn" prefWidth="75.0" text="Должники по инструментам" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </AnchorPane>
                        <HBox alignment="BOTTOM_LEFT">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onRefreshReportClick" text="Обновить">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#onSearchReportClick" text="Поиск">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <TextField fx:id="reportSearchField" promptText="Фильтр...">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </TextField>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
   <right>
      <VBox prefHeight="200.0" prefWidth="130.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#onPrihodClick" text="Приход">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onGiveMaterialClick" text="Выдать материал">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onGiveToolClick" text="Выдать инструмент">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onReturnToolClick" text="Вернуть инструмент">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </right>
</BorderPane>
